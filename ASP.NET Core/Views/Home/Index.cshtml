@using ASP_NET_Core.Models
@model IEnumerable<Employee>

<script>
    function getAllSelectedNodes(treeListInstance, parentKeys, skipParent) {
        let result = [];

        parentKeys.forEach((key) => {
            const insertIndex = result.length;
            const node = treeListInstance.getNodeByKey(key);
            let parentNode = node.parent;
            const childKeys = node.children.map((child) => child.key);

            while (parentNode.level >= 0 && !skipParent) {
                const isCollected = result.some((nodeItem) => nodeItem.key === parentNode.key);
                if (!isCollected && treeListInstance.isRowSelected(parentNode.key)) {
                    result.splice(insertIndex, 0, parentNode);
                    parentNode = parentNode.parent;
                } else {
                    break;
                }
            }

            result.push(node);
            result = result.concat(getAllSelectedNodes(treeListInstance, childKeys, true));
        });

        return result;
    }

    function onButtonClick() {
        const treeList = $("#treelist").dxTreeList("instance");
        const selectedRowKeys = treeList.getSelectedRowKeys();
        const names = getAllSelectedNodes(treeList, selectedRowKeys)
            .map((node) => node.data.Full_Name)
            .join(", ");

        $("#selected-keys").text(`Selected row keys: ${names}`);
    }
</script>

@(Html.DevExtreme().TreeList<Employee>()
    .ID("treelist")
    .DataSource(Model)
    .Height(500)
    .KeyExpr("ID")
    .ParentIdExpr("Head_ID")
    .ShowRowLines(true)
    .Selection(s => s.Mode(SelectionMode.Multiple).Recursive(true))
    .Columns(columns => {
        columns.Add().DataField("Full_Name");
        columns.Add().DataField("Title").Caption("Position");
        columns.Add().DataField("City");
        columns.Add().DataField("State");
        columns.Add().DataField("Hire_Date").DataType(GridColumnDataType.Date).Width(120);
    })
    .ExpandedRowKeys(new[] { 1, 2, 10 })
)

@(Html.DevExtreme().Button()
    .Text("Get all selected keys")
    .OnClick("onButtonClick")
)

<div id="selected-keys"></div>
